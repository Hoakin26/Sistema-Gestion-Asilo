# .env.prod.example — YS-174. Plantilla de variables para docker-compose.prod.yml.
#
# En el servidor: copie este archivo como .env.prod, complete los valores y
# levante con:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# El .env.prod no se versiona (.gitignore). Esta plantilla no trae ningún
# secreto: los campos vacíos se completan solo en el servidor.

# --- Dominio ------------------------------------------------------------------
# Subdominio que apunta a la IP pública del servidor, sin https://
# (por ejemplo, asilo.midominio.com). Caddy obtiene su certificado con
# Let's Encrypt. Para probar en una computadora local: localhost
DOMINIO=

# --- Base de datos ------------------------------------------------------------
POSTGRES_DB=asilo_cabeza_algodon
POSTGRES_USER=admin_asilo
# Una nueva, distinta de la de desarrollo: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Sesiones (JWT) -----------------------------------------------------------
# Al menos 256 bits aleatorios y distinto del de desarrollo:
#   openssl rand -base64 48
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=
# 8 h en milisegundos: un turno de trabajo (YS-48).
JWT_EXPIRATION=28800000

# --- Correo al familiar (RF-04) -----------------------------------------------
# Servidor SMTP real (por ejemplo, smtp.gmail.com en el puerto 587, con una
# contraseña de aplicación de la cuenta y no la contraseña personal).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Dirección que aparece como remitente; normalmente la misma de SPRING_MAIL_USERNAME.
APP_CORREO_REMITENTE=

# --- Primer Administrador del Asilo -------------------------------------------
# Solo se usa en el primer arranque, contra una base vacía. Si la contraseña
# queda en blanco, se genera una al azar y aparece una sola vez en el registro:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml logs backend
# En los dos casos el sistema exige cambiarla en el primer inicio de sesión (HU-32).
APP_ADMININICIAL_CORREO=
APP_ADMININICIAL_PASSWORD=

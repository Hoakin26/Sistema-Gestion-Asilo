# Plantilla de variables del frontend.
# Copie este archivo como .env en esta misma carpeta. El .env no se versiona.
# Vite lee el .env solo al arrancar: después de cambiarlo, reinicie npm run dev.

# URL base de la API, con el prefijo /api. Debe coincidir con server.port del backend.
VITE_API_URL=http://localhost:8080/api
